From 4e9510ebcfa53ab39306184365ffaa2cf6add357 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 22:31:21 +0000
Subject: [PATCH 1/4] Log checkout agent failures and disable Istio retries on
 PlaceOrder

The agent returned LLM errors to the caller without logging them, and
Istio's default retry policy re-sent each failed PlaceOrder twice.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013uN2juY2o76kkxXKGA7SLx
---
 release/kubernetes-manifests.yaml | 6 +++++-
 src/checkoutservice_agent/main.go | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/release/kubernetes-manifests.yaml b/release/kubernetes-manifests.yaml
index 16bb1ad..d19b035 100644
--- a/release/kubernetes-manifests.yaml
+++ b/release/kubernetes-manifests.yaml
@@ -475,7 +475,11 @@ spec:
   hosts:
   - checkoutservice
   http:
-  - route:
+  # No retries: PlaceOrder charges the card, so a retry can double-charge,
+  # and Istio's default (2 retries on "unavailable") triples every failed agent order.
+  - retries:
+      attempts: 0
+    route:
     - destination:
         host: checkoutservice
         subset: original
diff --git a/src/checkoutservice_agent/main.go b/src/checkoutservice_agent/main.go
index 562d0f1..691b6a5 100644
--- a/src/checkoutservice_agent/main.go
+++ b/src/checkoutservice_agent/main.go
@@ -76,6 +76,9 @@ func (s *checkoutServiceServer) PlaceOrder(ctx context.Context, req *pb.PlaceOrd
 	if err != nil {
 		statusValue = "FAILED"
 		errorMsg = err.Error()
+		log.Errorf("[PlaceOrder] failed after %v: %v", time.Since(start), err)
+	} else {
+		log.Infof("[PlaceOrder] done in %v", time.Since(start))
 	}
 
 	orderID := ""
-- 
