From 0f13587468a5b080f802adca8676c6e5c6cef1fb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 23:13:41 +0000
Subject: [PATCH 3/4] Cap Ollama reply length and use temperature 0 in the
 checkout agent

llama3.2:1b on CPU generated ~700 tokens per step (~60s), which hit the
loadgenerator's 60s request timeout. num_predict defaults to 300 and can
be changed with OLLAMA_NUM_PREDICT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013uN2juY2o76kkxXKGA7SLx
---
 src/checkoutservice_agent/ollama/client.go | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/checkoutservice_agent/ollama/client.go b/src/checkoutservice_agent/ollama/client.go
index 95ab122..2797744 100644
--- a/src/checkoutservice_agent/ollama/client.go
+++ b/src/checkoutservice_agent/ollama/client.go
@@ -11,6 +11,7 @@ import (
 	"net/http"
 	"os"
 	"path/filepath"
+	"strconv"
 	"time"
 )
 
@@ -61,6 +62,7 @@ type chatRequest struct {
 	Messages []Message        `json:"messages"`
 	Tools    []ToolDefinition `json:"tools,omitempty"`
 	Stream   bool             `json:"stream"`
+	Options  map[string]any   `json:"options,omitempty"`
 }
 
 // chatResponse is the body received from /api/chat.
@@ -78,6 +80,7 @@ type Client struct {
 	baseURL    string
 	model      string
 	httpClient *http.Client
+	options    map[string]any
 }
 
 // New creates a new Ollama client.
@@ -88,6 +91,7 @@ func New(baseURL, model string) *Client {
 		httpClient: &http.Client{
 			Timeout: 360 * time.Second,
 		},
+		options: defaultOptions(),
 	}
 }
 
@@ -99,6 +103,7 @@ func (c *Client) Chat(ctx context.Context, messages []Message, tools []ToolDefin
 		Messages: messages,
 		Tools:    tools,
 		Stream:   false,
+		Options:  c.options,
 	}
 
 	data, err := json.Marshal(body)
@@ -158,3 +163,18 @@ func resultsDir() string {
 	}
 	return "/results"
 }
+
+// defaultOptions caps the reply length and makes tool selection deterministic.
+// Small models on CPU otherwise ramble for hundreds of tokens per step.
+// OLLAMA_NUM_PREDICT overrides the cap (0 or less = no cap).
+func defaultOptions() map[string]any {
+	numPredict := 300
+	if v, err := strconv.Atoi(os.Getenv("OLLAMA_NUM_PREDICT")); err == nil {
+		numPredict = v
+	}
+	opts := map[string]any{"temperature": 0}
+	if numPredict > 0 {
+		opts["num_predict"] = numPredict
+	}
+	return opts
+}
-- 
